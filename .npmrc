# registry.npmjs.org is unreachable from this network: it is filtered by TLS SNI
# hostname, not by IP (plain HTTP to it returns 403 in ~18ms, and
# registry.yarnpkg.com resolves into the *same* Cloudflare /16 and answers
# normally). pnpm reads `dist.tarball` out of package metadata verbatim, and
# that field is always an absolute registry.npmjs.org URL — so pointing pnpm
# straight at the mirror resolves metadata but still resets on every tarball.
#
# tools/registry-proxy.cjs fronts npm's own mirror and rewrites those URLs.
# Start it with:  node tools/registry-proxy.cjs &
#
# If you are on a network where registry.npmjs.org works, delete this line —
# nothing else in the repo depends on it.
registry=https://registry.npmjs.org/

# Fail in a minute rather than hanging for ten if the proxy is not running.
fetch-retries=5
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000
fetch-timeout=120000

# NOTE: pnpm's own settings (nodeLinker, strictPeerDependencies, allowBuilds)
# live in pnpm-workspace.yaml as of pnpm 11 — they are ignored here.
