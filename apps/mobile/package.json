{
  "name": "@cricket/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "pnpm --filter @cricket/tokens build && expo start",
    "android": "pnpm --filter @cricket/tokens build && expo start --android",
    "ios": "pnpm --filter @cricket/tokens build && expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "check:sdk": "expo install --check",
    "test": "echo \"apps/mobile is covered by Maestro E2E, not unit tests\" && exit 0",
    "e2e": "maestro test .maestro"
  },
  "dependencies": {
    "@cricket/domain": "workspace:*",
    "@cricket/tokens": "workspace:*",
    "@expo-google-fonts/archivo": "^0.4.2",
    "@expo-google-fonts/ibm-plex-mono": "^0.4.1",
    "@expo-google-fonts/inter-tight": "^0.4.2",
    "expo": "~54.0.27",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.10",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.17",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "moti": "^0.30.0",
    "nativewind": "^4.2.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-reanimated": "~4.1.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.2",
    "tailwindcss": "^3.4.19",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "eslint-config-expo": "~10.0.0"
  }
}