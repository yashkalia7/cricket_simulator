{
  "name": "@cricket/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/server.js",
    "start": "node dist/server.js",
    "dev": "node --watch dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run"
  },
  "dependencies": {
    "@cricket/domain": "workspace:*",
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "typescript": "^5.6.0",
    "vitest": "^3"
  }
}
