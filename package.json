{
  "name": "cricket-tactical-simulator",
  "version": "0.1.0",
  "private": true,
  "description": "A decision gym for cricket. See BUILD.md.",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "check": "turbo run typecheck test lint check:sdk",
    "mobile": "pnpm --filter @cricket/mobile run start",
    "mobile:android": "pnpm --filter @cricket/mobile run android",
    "e2e": "maestro test apps/mobile/.maestro"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "eslint": "^9",
    "turbo": "^2",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8"
  },
  "engines": {
    "node": ">=20.19.4"
  }
}
